# Copy to .env for local development. Never commit real secrets.

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/stopnshop
JWT_SECRET=change-me-to-a-long-random-string

# Browser origin for Stripe redirects and password-reset links (Vite default: 5173)
CLIENT_URL=http://localhost:5173

# Optional: comma-separated browser origins (defaults include localhost:3000 and :5173)
# CORS_ORIGINS=http://localhost:5173

# Required only when you test Stripe checkout locally.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Fresh local DB seed admin credentials (`npm run seed`).
SEED_ADMIN_EMAIL=admin@localhost.test
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Local Admin

BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM=
